# ============================================================
# VIRA — VARIABLES DE ENTORNO
# Copiar a `.env.local` (desarrollo) o cargarlas en Vercel.
#
# TODAS estas variables son PÚBLICAS: Vite las inyecta en el
# bundle del navegador. Nunca pongas acá un token de API de
# Cloudflare, una Access Key de R2 ni ningún secreto.
# La subida de assets se hace con `wrangler` desde tu máquina
# o desde CI, nunca desde el frontend.
# ============================================================

# ---- SITIO --------------------------------------------------

# Dominio público. Lo usan los enlaces que salen del sitio (el botón
# "Consultar por esta propiedad" arma el link a WhatsApp con esta base),
# para que nunca apunten a localhost ni a un preview de Vercel.
VITE_SITE_URL=https://www.viraconstructora.com

# ---- MEDIOS / CLOUDFLARE -----------------------------------

# Origen público de imágenes y videos.
# Es el dominio del bucket R2 conectado a un dominio propio y
# servido a través de la CDN de Cloudflare.
# Sin esta variable, todo se sirve desde /public como hoy.
# Ej: https://media.viraconstructora.com
VITE_MEDIA_BASE_URL=

# Activa las transformaciones de imagen del edge (/cdn-cgi/image).
# Requiere tener Image Resizing habilitado en la zona de Cloudflare.
# Con esto las imágenes salen en AVIF/WebP y en el tamaño exacto
# que pide cada breakpoint.
VITE_CF_IMAGE_RESIZING=false

# Calidad de las imágenes transformadas (1-100).
VITE_CF_IMAGE_QUALITY=78

# ---- CLOUDFLARE STREAM (opcional) --------------------------
# Sólo hace falta si se migra el video a Stream en vez de R2.
# El código de cliente aparece en la URL del reproductor de Stream.
VITE_CF_STREAM_CUSTOMER_CODE=

# Mapa JSON de ruta local -> id de video en Stream.
# Ej: {"img/ANCLA/VideoAncla.mp4":"31c9291ab41fac05471db4e73aa11717"}
VITE_CF_STREAM_IDS={}
